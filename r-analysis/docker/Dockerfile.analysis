FROM rocker/r-ver:4.3.2

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libcurl4-openssl-dev \
    libgit2-dev \
    libssl-dev \
    libxml2-dev \
    make \
    g++ \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN R -q -e "options(repos = c(CRAN = 'https://cloud.r-project.org')); install.packages(c('data.table', 'jsonlite', 'DBI', 'RClickhouse', 'yaml', 'dbscan', 'isotree'))"

WORKDIR /app
COPY R /app/R
COPY rules /app/rules

CMD ["Rscript", "/app/R/main.R"]
