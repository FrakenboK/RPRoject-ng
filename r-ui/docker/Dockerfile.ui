FROM rocker/r-ver:4.3.2

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    libcurl4-openssl-dev \
    libgit2-dev \
    libssl-dev \
    libxml2-dev \
    make \
    g++ \
    pkg-config \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
       | gpg --dearmor -o /usr/share/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

ENV PAK_SYSREQS=false
ENV MAKEFLAGS="-j4"

RUN R -q -e "install.packages('pak', repos = sprintf('https://r-lib.github.io/p/pak/stable/%s/%s/%s', .Platform[['pkgType']], R.Version()[['os']], R.Version()[['arch']]))"

RUN R -q -e "options(repos = c(CRAN = 'https://cran.rstudio.com')); \
    pak::pkg_install(c('shiny', 'bslib', 'DT', 'data.table', 'jsonlite', 'DBI', 'bit64', 'RClickhouse', 'processx'))"

WORKDIR /app
COPY R /app/R

EXPOSE 3838

CMD ["Rscript", "-e", "shiny::runApp('/app/R', host='0.0.0.0', port=3838)"]
